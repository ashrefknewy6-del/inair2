    <string name="about_version">Version 1.0.0 (Build 35)</string>
    <string name="about_desc">InAir is a private, zero-cloud workstation utility designed to mirror your Android screen, execute gestures, and exchange files at local network speeds.</string>
    <string name="btn_privacy_policy">Privacy Policy &amp; Security</string>

    <!-- Privacy Policy Screen -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_section_local_network">100% Local Network Processing</string>
    <string name="privacy_local_network_desc">InAir operates entirely on your local Wi-Fi or Local-Only Hotspot. No video frames, input commands, file contents, or device identifiers are ever sent over the internet or uploaded to any third-party cloud or analytics server.</string>
    <string name="privacy_section_media_projection">Screen Capture &amp; MediaProjection</string>
    <string name="privacy_media_projection_desc">InAir captures display frames only while the broadcast server is actively started by you. A persistent system notification is always visible while screen capture is active, and you can stop it at any second with a single tap.</string>
    <string name="privacy_section_accessibility">Accessibility API Usage</string>
    <string name="privacy_accessibility_desc">The Accessibility Service is used solely to synthesize user-commanded touch taps and system navigation events from your authorized web browser session. It does not monitor notifications, track passwords, or read screen contents.</string>
    <string name="privacy_section_storage">File Storage Protection</string>
    <string name="privacy_storage_desc">File sharing is strictly confined to the directory you explicitly choose through the Android Storage Access Framework. The web dashboard has no access to your private app storage or other folders.</string>

