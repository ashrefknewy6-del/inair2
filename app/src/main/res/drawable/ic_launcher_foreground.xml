<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top wide wireless arc -->
    <path
        android:pathData="M 33,31 C 40,23 68,23 75,31"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="33"
                android:startY="25"
                android:endX="75"
                android:endY="35"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2D3F" />
                <item android:offset="1.0" android:color="#B3001B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Middle wireless arc -->
    <path
        android:pathData="M 40,37 C 45,31 63,31 68,37"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="40"
                android:startY="32"
                android:endX="68"
                android:endY="40"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2D3F" />
                <item android:offset="1.0" android:color="#B3001B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner wireless arc -->
    <path
        android:pathData="M 47,43 C 50,39 58,39 61,43"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="47"
                android:startY="39"
                android:endX="61"
                android:endY="45"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2D3F" />
                <item android:offset="1.0" android:color="#B3001B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Smartphone Body Outline -->
    <path
        android:pathData="M 46,49 L 62,49 A 6,6 0 0 1 68,55 L 68,81 A 6,6 0 0 1 62,87 L 46,87 A 6,6 0 0 1 40,81 L 40,55 A 6,6 0 0 1 46,49 Z"
        android:strokeWidth="3"
        android:fillColor="#1A0A0D">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="40"
                android:startY="49"
                android:endX="68"
                android:endY="87"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2D3F" />
                <item android:offset="1.0" android:color="#B3001B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Smartphone Display Screen -->
    <path
        android:pathData="M 47,56 L 61,56 A 2,2 0 0 1 63,58 L 63,77 A 2,2 0 0 1 61,79 L 47,79 A 2,2 0 0 1 45,77 L 45,58 A 2,2 0 0 1 47,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="56"
                android:endX="63"
                android:endY="79"
                android:type="linear">
                <item android:offset="0.0" android:color="#4DFF2D3F" />
                <item android:offset="1.0" android:color="#26B3001B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Speaker Bar -->
    <path
        android:pathData="M 51,52 L 57,52"
        android:strokeWidth="1.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="51"
                android:startY="52"
                android:endX="57"
                android:endY="52"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF6B6B" />
                <item android:offset="1.0" android:color="#FF2D3F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Home Pill Indicator -->
    <path
        android:pathData="M 50,83 L 58,83"
        android:strokeWidth="2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="50"
                android:startY="83"
                android:endX="58"
                android:endY="83"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2D3F" />
                <item android:offset="1.0" android:color="#B3001B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
